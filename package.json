{
  "name": "etheria",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "db:pg:generate": "pnpm --filter @etheria/database db:generate",
    "db:pg:push": "pnpm --filter @etheria/database db:push",
    "db:pg:studio": "pnpm --filter @etheria/database db:studio",
    "db:seed": "node -e \"console.log('Static balance config now lives in apps/api/src/domain and no longer needs DB seeding.')\"",
    "db:seed:legacy": "cd apps/api && npx tsx seed-matecito.ts",
    "db:setup": "cd apps/api && npx tsx setup-matecito.ts",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build": "npx cap sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "prettier": "^3.5.0",
    "supabase": "^2.98.2",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capawesome/capacitor-badge": "^8.0.2"
  }
}
