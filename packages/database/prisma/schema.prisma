generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id
  email        String?  @unique
  name         String?
  avatar       String?
  isBot        Boolean  @default(false)
  botProfile   String?
  passwordHash String?
  passwordSalt String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cities       City[]
  sessions     Session[]
  sentMail     MailMessage[] @relation("MailSender")
  receivedMail MailMessage[] @relation("MailRecipient")
  botPlayer    BotPlayer?

  @@map("users")
}

model Session {
  id         String   @id
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model BotPlayer {
  id         String    @id
  userId     String    @unique
  cityId     String    @unique
  worldId    String    @default("default")
  profile    BotProfile
  status     BotStatus @default(ACTIVE)
  state      Json?
  createdAt  DateTime  @default(now())
  lastTickAt DateTime?
  nextTickAt DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id])
  logs  BotActionLog[]

  @@index([status, nextTickAt])
  @@index([profile])
  @@index([worldId])
  @@map("bot_players")
}

model BotActionLog {
  id           String          @id
  botId        String
  cityId       String
  actionType   BotActionType
  status       BotActionStatus
  reason       String?
  errorKind    String?
  errorMessage String?
  payload      Json?
  createdAt    DateTime        @default(now())

  bot BotPlayer @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt])
  @@index([actionType, status, createdAt])
  @@index([cityId, createdAt])
  @@map("bot_action_logs")
}

model BotMetricsSnapshot {
  id                    String   @id
  windowStartedAt       DateTime
  windowEndedAt         DateTime
  attemptedByType       Json
  successfulActions     Int      @default(0)
  expectedBlocks        Int      @default(0)
  validationErrors      Int      @default(0)
  unexpectedErrors      Int      @default(0)
  blockedByQueue        Int      @default(0)
  blockedByResources    Int      @default(0)
  battlesCreated        Int      @default(0)
  battlesResolved       Int      @default(0)
  researchStarted       Int      @default(0)
  researchCompleted     Int      @default(0)
  createdAt             DateTime @default(now())

  @@index([windowStartedAt, windowEndedAt])
  @@map("bot_metrics_snapshots")
}

model City {
  id        String   @id
  name      String
  userId    String
  posX      Int      @default(0)
  posY      Int      @default(0)
  islandId  String?
  slotId    String?
  worldId   String   @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gold  Int @default(500)
  wood  Int @default(500)
  stone Int @default(200)
  food  Int @default(200)
  gems  Int @default(0)

  goldPerHour  Int @default(0)
  woodPerHour  Int @default(0)
  stonePerHour Int @default(0)
  foodPerHour  Int @default(0)

  maxGold  Int @default(1000)
  maxWood  Int @default(1000)
  maxStone Int @default(500)
  maxFood  Int @default(500)

  lastResourceUpdate DateTime @default(now())
  techBonuses        Json?
  winterState        Json?
  lastWinterEvaluatedAt DateTime?
  power              Int      @default(0)
  lastAttackAt       DateTime?
  shieldExpiresAt    DateTime?
  race               String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id])

  buildings      Building[]
  units          CityUnit[]
  buildQueues    BuildQueue[]
  trainingQueues TrainingQueue[]
  researchQueues ResearchQueue[]
  cityTechs      CityTech[]
  quests         PlayerQuest[]

  @@index([userId])
  @@index([posX, posY])
  @@index([lastResourceUpdate])
  @@index([createdAt])
  @@index([worldId])
  @@map("cities")
}

model Building {
  id         String       @id
  type       BuildingType
  level      Int          @default(1)
  positionX  Int
  positionY  Int
  cityId     String
  createdAt  DateTime     @default(now())
  upgradedAt DateTime     @default(now())

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, type])
  @@index([cityId])
  @@map("buildings")
}

model CityUnit {
  id     String   @id
  type   UnitType
  count  Int      @default(0)
  cityId String

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, type])
  @@index([cityId])
  @@map("units")
}

model BuildQueue {
  id           String       @id
  cityId       String
  buildingId   String
  buildingType BuildingType
  targetLevel  Int
  startedAt    DateTime
  completesAt  DateTime
  isComplete   Boolean      @default(false)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@index([cityId, buildingType, isComplete])
  @@index([isComplete, completesAt])
  @@map("build_queues")
}

model TrainingQueue {
  id          String   @id
  cityId      String
  unitType    UnitType
  count       Int
  startedAt   DateTime
  completesAt DateTime
  isComplete  Boolean  @default(false)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@index([isComplete, completesAt])
  @@map("training_queues")
}

model ResearchQueue {
  id          String   @id
  cityId      String
  techId      String
  targetLevel Int
  startedAt   DateTime
  completesAt DateTime
  isComplete  Boolean  @default(false)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@index([isComplete, completesAt])
  @@map("research_queues")
}

model CityTech {
  id         String   @id
  cityId     String
  techId     String
  level      Int
  unlockedAt DateTime

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, techId])
  @@index([cityId])
  @@map("city_techs")
}

model Battle {
  id             String       @id
  attackerCityId String
  defenderCityId String
  status         BattleStatus @default(MARCHING)
  startedAt      DateTime
  arrivesAt      DateTime
  resolvedAt     DateTime?
  returnsAt      DateTime?
  units          Json
  loot           Json?
  result         Json?

  @@index([attackerCityId])
  @@index([defenderCityId])
  @@index([status, arrivesAt])
  @@index([defenderCityId, startedAt])
  @@index([attackerCityId, resolvedAt])
  @@map("battles")
}

model BattleReport {
  id             String   @id
  battleId       String
  cityId         String
  attackerCityId String
  defenderCityId String
  attackerName   String?
  defenderName   String?
  status         String
  attackerLosses Json
  defenderLosses Json
  loot           Json?
  read           Boolean  @default(false)
  createdAt      DateTime

  @@index([cityId])
  @@index([battleId])
  @@map("battle_reports")
}

model Alliance {
  id          String   @id
  name        String
  tag         String   @unique
  ownerUserId String
  publicIntro String   @default("")
  forumText   String   @default("")
  honorScore  Int      @default(100)
  treatiesSigned Int   @default(0)
  treatiesBroken Int   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   AllianceMember[]
  messages  ChatMessage[]
  effects   AllianceEffect[]
  diplomacyA AllianceDiplomacy[] @relation("AllianceDiplomacyA")
  diplomacyB AllianceDiplomacy[] @relation("AllianceDiplomacyB")

  @@map("alliances")
}

model AllianceMember {
  id         String   @id
  allianceId String
  userId     String
  role       String
  createdAt  DateTime @default(now())

  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([allianceId])
  @@map("alliance_members")
}

model AllianceDiplomacy {
  id          String   @id
  allianceAId String
  allianceBId String
  status      DiplomacyStatus
  proposedByAllianceId String?
  acceptedAt  DateTime?
  expiresAt   DateTime?
  brokenByAllianceId String?
  brokenAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  allianceA Alliance @relation("AllianceDiplomacyA", fields: [allianceAId], references: [id], onDelete: Cascade)
  allianceB Alliance @relation("AllianceDiplomacyB", fields: [allianceBId], references: [id], onDelete: Cascade)

  @@unique([allianceAId, allianceBId])
  @@index([status])
  @@map("alliance_diplomacy")
}

model AllianceDiplomacyEvent {
  id          String   @id
  allianceId String
  otherAllianceId String?
  type        String
  message     String
  public      Boolean @default(true)
  createdAt   DateTime @default(now())

  @@index([allianceId, createdAt])
  @@map("alliance_diplomacy_events")
}

model AllianceEffect {
  id          String   @id
  allianceId String
  type        AllianceEffectType
  value       Float
  reason      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)

  @@index([allianceId, type, expiresAt])
  @@map("alliance_effects")
}

model ChatMessage {
  id           String      @id
  channel      ChatChannel
  senderUserId String
  senderName   String
  message      String
  allianceId   String?
  createdAt    DateTime    @default(now())

  alliance Alliance? @relation(fields: [allianceId], references: [id], onDelete: Cascade)

  @@index([channel, createdAt])
  @@index([allianceId, createdAt])
  @@map("chat_messages")
}

model MailMessage {
  id                String    @id
  senderUserId      String
  senderName        String
  recipientUserId   String
  recipientName     String
  recipientCityId   String?
  recipientCityName String?
  subject           String
  body              String
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  sender    User @relation("MailSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient User @relation("MailRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt, createdAt])
  @@index([senderUserId, createdAt])
  @@map("mail_messages")
}

enum BuildingType {
  TOWN_HALL
  GOLD_MINE
  LUMBER_MILL
  QUARRY
  FARM
  BARRACKS
  STABLE
  ALLIANCE_CENTER
  LIBRARY
  STORAGE
  TOWER
  MARKET
}

enum UnitType {
  WARRIOR
  ARCHER
  CAVALRY
  SIEGE
  SPY
}

enum BattleStatus {
  MARCHING
  ONGOING
  VICTORY
  DEFEAT
  RETURNING
}

enum ChatChannel {
  GLOBAL
  ALLIANCE
}

enum DiplomacyStatus {
  PROPOSED
  PEACE
  HOSTILE
  BROKEN
}

enum AllianceEffectType {
  PEACE_PRODUCTION
  DISHONOR_ATTACK
}

// ─── World / Multi-server ───

model World {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String?
  status      WorldStatus @default(ACTIVE)
  config      Json
  playerCount Int         @default(0)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  cities City[]
  seasons WorldSeasonState[]
  bots    BotPlayer[]

  @@map("worlds")
}

enum WorldStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

// ─── Season System ───

model WorldSeasonState {
  id            String   @id
  worldId       String   @default("default")
  currentSeason SeasonType
  nextSeason    SeasonType
  phase         SeasonPhaseType
  intensity     Float    @default(0)
  startedAt     DateTime
  peakAt        DateTime
  transitionAt  DateTime
  endsAt        DateTime
  updatedAt     DateTime

  world World @relation(fields: [worldId], references: [id])

  @@unique([worldId])
  @@map("world_season_state")
}

// ─── Barbarian System ───

model BarbarianCamp {
  id         String              @id
  name       String
  level      Int                  @default(1)
  archetype  BarbarianArchetypeType
  posX       Int
  posY       Int
  zoneId     String
  status     BarbarianCampStatusType @default(ACTIVE)
  spawnedAt  DateTime             @default(now())
  expiresAt  DateTime?
  lastActionAt DateTime?
  nextAttackAt DateTime?
  ownerEventId String?

  army     BarbarianArmy?
  attacks  BarbarianAttack[]
  battles  BarbarianBattle[]
  alerts   BarbarianAttackAlert[]

  @@index([status])
  @@index([status, lastActionAt])
  @@index([zoneId])
  @@index([posX, posY])
  @@map("barbarian_camps")
}

model BarbarianArmy {
  id     String   @id
  campId String   @unique
  units  Json
  power  Int      @default(0)

  camp   BarbarianCamp @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@index([campId])
  @@map("barbarian_armies")
}

model BarbarianBattle {
  id             String                    @id
  attackerCityId String
  targetCampId   String
  units          Json
  status         BarbarianBattleStatusType  @default(MARCHING)
  startedAt      DateTime
  arrivesAt      DateTime
  resolvedAt     DateTime?
  returnsAt      DateTime?
  result         Json?
  loot           Json?

  camp           BarbarianCamp             @relation(fields: [targetCampId], references: [id])

  @@index([attackerCityId])
  @@index([targetCampId])
  @@index([status, arrivesAt])
  @@map("barbarian_battles")
}

model BarbarianAttack {
  id           String                     @id
  campId       String
  targetCityId String
  units        Json
  status       BarbarianAttackStatusType  @default(MARCHING)
  startedAt    DateTime
  arrivesAt    DateTime
  resolvedAt   DateTime?
  returnsAt    DateTime?
  result       Json?
  loot         Json?

  camp         BarbarianCamp              @relation(fields: [campId], references: [id])

  @@index([campId])
  @@index([targetCityId])
  @@index([status, arrivesAt])
  @@map("barbarian_attacks")
}

model BarbarianAttackAlert {
  id             String   @id
  cityId         String
  campId         String
  campName       String
  archetype      BarbarianArchetypeType
  estimatedPower Int
  arrivesAt      DateTime
  warnedAt       DateTime
  read           Boolean  @default(false)

  camp           BarbarianCamp @relation(fields: [campId], references: [id])

  @@index([cityId, read, arrivesAt])
  @@index([campId])
  @@map("barbarian_attack_alerts")
}

// ─── Enums ───

enum SeasonType {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum SeasonPhaseType {
  START
  PEAK
  TRANSITION
}

enum BarbarianArchetypeType {
  RAIDERS
  HUNTERS
  MARAUDERS
  WARHOST
  NOMADS
}

enum BarbarianCampStatusType {
  ACTIVE
  DEFEATED
  DESPAWNING
}

enum BarbarianBattleStatusType {
  MARCHING
  RETURNING
  VICTORY
  DEFEAT
}

enum BarbarianAttackStatusType {
  MARCHING
  ARRIVED
  RETURNING
  VICTORY
  DEFEAT
}

enum BotProfile {
  ECONOMIST
  MILITARIST
  TECH_RUSHER
  BALANCED
}

enum BotStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum BotActionType {
  UPGRADE_BUILDING
  TRAIN_UNITS
  START_RESEARCH
  ATTACK_CITY
  ATTACK_BARBARIAN
  SEND_RESOURCES
  CREATE_MARKET_OFFER
  ACCEPT_MARKET_OFFER
  CONTRIBUTE_ALLIANCE_OBJECTIVE
  SCOUT_TARGET
  IDLE
}

enum BotActionStatus {
  SUCCESS
  EXPECTED_BLOCKED
  VALIDATION_ERROR
  UNEXPECTED_ERROR
}

model TradeCaravan {
  id               String   @id
  senderCityId     String
  recipientCityId  String
  resources        Json
  status           String   @default("MARCHING") // "MARCHING", "COMPLETED", "RETURNING"
  startedAt        DateTime @default(now())
  arrivesAt        DateTime
  completedAt      DateTime?

  @@index([senderCityId])
  @@index([recipientCityId])
  @@index([status, arrivesAt])
  @@map("trade_caravans")
}

model GameReport {
  id        String   @id
  type      String
  userId    String
  cityId    String?
  title     String
  summary   String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([cityId, createdAt])
  @@index([type, createdAt])
  @@map("game_reports")
}

model PlayerQuest {
  id        String   @id
  userId    String
  cityId    String
  questId   String
  type      String
  titleKey  String
  summaryKey String
  target    Int
  progress  Int      @default(0)
  reward    Json
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claimedAt DateTime?

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, questId])
  @@index([userId, status])
  @@map("player_quests")
}

// ─── Notifications ───

model Notification {
  id        String   @id
  userId    String
  type      NotificationType
  title     String
  body      String
  payload   Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

enum NotificationType {
  BUILD_COMPLETE
  TRAINING_COMPLETE
  UNDER_ATTACK
  BATTLE_RESULT
  RALLY_INVITE
  RALLY_LAUNCHED
  CITY_CONQUERED
  SPY_RESULT
  DAILY_QUEST_RESET
  ACHIEVEMENT_UNLOCKED
  RANKED_OVERTAKEN
}

// ─── Daily Quests ───

model DailyQuest {
  id        String   @id
  userId    String
  cityId    String
  questId   String
  title     String
  summary   String
  target    Int
  progress  Int      @default(0)
  reward    Json
  status    String   @default("ACTIVE")
  date      String   // YYYY-MM-DD — the day this quest belongs to
  claimedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, questId, date])
  @@index([userId, date, status])
  @@map("daily_quests")
}

// ─── Rally Attacks ───

model RallyAttack {
  id            String   @id
  createdByCityId String
  targetCityId  String
  targetCampId  String?
  launchAt      DateTime
  status        RallyStatus @default(OPEN)
  createdAt     DateTime @default(now())

  participants  RallyParticipant[]

  @@index([status, launchAt])
  @@index([createdByCityId])
  @@map("rally_attacks")
}

model RallyParticipant {
  id         String   @id
  rallyId    String
  userId     String
  cityId     String
  units      Json
  joinedAt   DateTime @default(now())

  rally RallyAttack @relation(fields: [rallyId], references: [id], onDelete: Cascade)

  @@unique([rallyId, cityId])
  @@index([rallyId])
  @@map("rally_participants")
}

enum RallyStatus {
  OPEN
  LAUNCHED
  CANCELLED
}

// ─── City Conquest ───

model CityConquestProgress {
  id          String   @id
  attackerCityId String
  defenderCityId String
  wins        Int      @default(0)
  winsRequired Int     @default(3)
  updatedAt   DateTime @updatedAt

  @@unique([attackerCityId, defenderCityId])
  @@index([defenderCityId])
  @@map("city_conquest_progress")
}

// ─── Espionage ───

model EspionageMission {
  id             String   @id
  spyCityId      String
  targetCityId   String
  status         EspionageStatus @default(TRAVELING)
  result         Json?
  expiresAt      DateTime?
  startedAt      DateTime @default(now())
  resolvedAt     DateTime?
  arrivesAt      DateTime

  @@index([spyCityId])
  @@index([targetCityId])
  @@index([status, arrivesAt])
  @@map("espionage_missions")
}

enum EspionageStatus {
  TRAVELING
  SUCCESS
  CAUGHT
  EXPIRED
}

// ─── Achievements ───

model Achievement {
  id          String   @id
  key         String   @unique
  titleKey    String
  summaryKey  String
  iconKey     String
  points      Int      @default(10)
  createdAt   DateTime @default(now())

  playerAchievements PlayerAchievement[]

  @@map("achievements")
}

model PlayerAchievement {
  id            String   @id
  userId        String
  achievementId String
  achievementKey String
  unlockedAt    DateTime @default(now())

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("player_achievements")
}

// ─── Activity Feed ───

model ActivityFeed {
  id        String   @id
  type      String
  actorName String
  actorId   String
  payload   Json
  public    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([public, createdAt])
  @@index([actorId, createdAt])
  @@map("activity_feed")
}

// ─── Wonder ───

model Wonder {
  id              String   @id @default("world_wonder")
  holderAllianceId String?
  holderCityId    String?
  controlStartedAt DateTime?
  daysControlled  Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@map("wonder")
}

model MarketOffer {
  id               String   @id
  creatorUserId    String
  creatorCityId    String
  giveResource     String
  giveAmount       Int
  wantResource     String
  wantAmount       Int
  feeRate          Float
  status           String   @default("OPEN")
  acceptedByUserId String?
  acceptedByCityId String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  acceptedAt       DateTime?

  @@index([status, expiresAt])
  @@index([creatorCityId])
  @@map("market_offers")
}

model AllianceObjective {
  id           String   @id
  allianceId   String
  title        String
  summary      String
  target       Json
  progress     Json
  rewardEffect Json
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  completedAt  DateTime?

  contributions AllianceObjectiveContribution[]

  @@index([allianceId, status])
  @@map("alliance_objectives")
}

model AllianceObjectiveContribution {
  id          String   @id
  objectiveId String
  allianceId  String
  userId      String
  cityId      String
  resources   Json
  createdAt   DateTime @default(now())

  objective AllianceObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId, userId])
  @@map("alliance_objective_contributions")
}
